{
  "name": "llama-sync",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin: dynamic model inventory for custom OpenAI-compatible (llama.cpp) providers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/test",
    "README.md",
    "LICENSE",
    "options.example.jsonc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattzink/llama-sync.git"
  },
  "homepage": "https://github.com/mattzink/llama-sync#readme",
  "bugs": {
    "url": "https://github.com/mattzink/llama-sync/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "llama.cpp",
    "llama-server",
    "models"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.20"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
